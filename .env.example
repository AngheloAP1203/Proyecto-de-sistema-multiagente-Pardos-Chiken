# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del módulo de Quejas con IA (Google Gemini)
# Copia este archivo a `.env` y completa tu API key gratuita.
# Consíguela gratis en: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────────────

# MODO DEMO / LOCAL
# La key queda expuesta en el bundle del navegador → SOLO para desarrollo.
# Si la dejas vacía, la app funciona igual en MODO LOCAL (heurística sin LLM).
VITE_GEMINI_API_KEY=

# MODO PRODUCCIÓN (proxy serverless)
# Con VITE_USE_PROXY=true el front NO llama a los proveedores directamente:
#   · Quejas/auditoría (M1/M3) → /api/triage  (key: GEMINI_API_KEY)
#   · Asistente IA (M5)        → /api/llm     (key: GROQ_API_KEY)
# Las keys server-side viven en process.env (Vercel) y NUNCA en el bundle.
# En desarrollo, vite.config.js monta los mismos handlers, así que el proxy
# también funciona en local con `npm run dev`.
#
# IMPORTANTE para producción: además de poner esto en true, NO definas las
# variantes VITE_* de las keys en el entorno de build — cualquier variable con
# prefijo VITE_ referenciada por el código se incrusta en el bundle.
VITE_USE_PROXY=false

# Keys del lado servidor (handlers de api/). NO llevan prefijo VITE_.
GEMINI_API_KEY=
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PROVEEDOR LLM
# Vacío o "gemini" → Google Gemini (free tier: 20 peticiones/día).
# "groq"           → Llama 3.3 70B en Groq (free tier: 30/min, 1000/día).
# Consigue la key gratis en: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────────────────────
VITE_LLM_PROVIDER=gemini
VITE_GROQ_API_KEY=

# Modelo concreto (opcional). Los límites de tokens de Groq son POR MODELO, así que
# cambiar de modelo da una bolsa nueva. Deja vacío para usar el default del proveedor.
#   groq   → llama-3.3-70b-versatile (default) · llama-3.1-8b-instant
#   gemini → gemini-2.5-flash (default)
VITE_LLM_MODEL=
