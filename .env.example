# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del módulo de Quejas con IA (Google Gemini)
# Copia este archivo a `.env` y completa tu API key gratuita.
# Consíguela gratis en: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────────────

# MODO DEMO / LOCAL
# La key queda expuesta en el bundle del navegador → SOLO para desarrollo.
# Si la dejas vacía, la app funciona igual en MODO LOCAL (heurística sin LLM).
VITE_GEMINI_API_KEY=

# MODO PRODUCCIÓN (proxy serverless)
# Pon VITE_USE_PROXY=true para que el front llame a /api/triage en vez del SDK directo.
# La key real vive en el servidor (GEMINI_API_KEY), nunca en el cliente.
VITE_USE_PROXY=false

# Key del lado servidor (usada por api/triage.js en Vercel). NO lleva prefijo VITE_.
GEMINI_API_KEY=
