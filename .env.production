# ─────────────────────────────────────────────────────────────────────────────
# Configuración de PRODUCCIÓN (la carga todo `vite build`).
# SIN SECRETOS: este archivo SÍ se versiona.
#
# En producción el front no habla con los proveedores: todo pasa por los
# handlers serverless (/api/llm para el asistente, /api/triage para quejas).
# Las keys reales viven en las variables de entorno de Vercel:
#   GROQ_API_KEY   · GEMINI_API_KEY   (sin prefijo VITE_)
#
# Las variantes VITE_ se vacían aquí a propósito: cualquier VITE_* definida en
# el build se incrusta en el bundle del navegador.
# ─────────────────────────────────────────────────────────────────────────────
VITE_USE_PROXY=true
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_LLM_MODEL=
